{
  "name": "surgical-trainer-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A data-driven 3D surgical training simulator for medical students. Educational use only.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets": "vitest run tests/assetManifest.test.ts --reporter=verbose"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
